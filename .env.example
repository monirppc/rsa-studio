# RSA Studio settings. Copy this file to ".env" (start.bat does it for you), then paste your key.

# Which free AI to use: gemini (recommended), groq, openrouter, or ollama
PROVIDER=gemini

# Gemini (free key from https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Only if you switch PROVIDER:
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OLLAMA_MODEL=llama3.1

# Pause between AI calls in milliseconds. Raise it (for example 8000) if you see "limit reached".
MIN_GAP_MS=4500

PORT=3000
